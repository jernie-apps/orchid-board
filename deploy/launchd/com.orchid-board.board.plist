<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>Label</key>
	<string>com.orchid-board.board</string>
	<key>ProgramArguments</key>
	<array>
		<string>__NODE__</string>
		<string>src/main.ts</string>
	</array>
	<key>WorkingDirectory</key>
	<string>__REPO__</string>
	<key>EnvironmentVariables</key>
	<dict>
		<key>ORCHID_BOARD_HOME</key>
		<string>__HOME__/.orchid/board</string>
	</dict>
	<key>RunAtLoad</key>
	<true/>
	<key>KeepAlive</key>
	<true/>
	<key>StandardOutPath</key>
	<string>__HOME__/.orchid/board/logs/board.out.log</string>
	<key>StandardErrorPath</key>
	<string>__HOME__/.orchid/board/logs/board.err.log</string>
</dict>
</plist>
